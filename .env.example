# Values for the manifests. Copy this file to .env and fill in every key; the
# S3_ values come from step 1 (object storage). Then run:
#   ./scripts/render.sh
# which writes ready-to-apply manifests to build/, plus build/env.sh with the
# namespace names for the commands in docs/deployment-guide.md. The script only
# writes files; it never talks to a cluster. .env and build/ are git-ignored.
#
# One KEY=value per line. Quotes around a value are optional.

# Your cluster's domain. It prefixes the environment label key
# (<CLUSTER_DOMAIN>/environment) on the instance, its nodes and the restored
# objects, and is the cluster part of Fusion's backup names (apps.<CLUSTER_DOMAIN>).
CLUSTER_DOMAIN=my.cluster

# Namespaces
FUSION_NS=ibm-spectrum-fusion-ns
OP_NS=db2-operator
SOURCE_NS=db2u-instance
TARGET_NS=db2u-instance-dev

# Db2uInstance
DB2_INSTANCE_NAME=dwdb
DB2_LICENSE=
STORAGE_CLASS=isf-block-file-delete-sc

# Environment label of the restore target: the Restore's transformMapping ENV,
# and the <CLUSTER_DOMAIN>/environment label on the nodes it runs on.
ENV_LABEL=dev

# Object storage (docs/object-storage-setup.md)
S3_BUCKET_NAME=db2u-instance-bucket
S3_ENDPOINT=https://my.object.storage:9000
# The endpoint's CA certificate (PEM), saved as a file. The path is from the
# repository root; *.crt files are git-ignored. Leave empty if the endpoint
# has a publicly trusted certificate.
S3_CA_CERT=object-storage-cert-secret.crt
# Required by the S3 client; MinIO ignores the value.
S3_REGION=us-west-2
# The access key pair for the bucket user. S3_ACCESS_KEY is the secret key.
S3_ACCESS_KEY_ID=
S3_ACCESS_KEY=
